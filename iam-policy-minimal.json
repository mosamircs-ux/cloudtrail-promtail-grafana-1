{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "ReadCloudTrailLogsFromS3",
            "Effect": "Allow",
            "Action": [
                "s3:GetObject",
                "s3:ListBucket"
            ],
            "Resource": [
                "arn:aws:s3:::aws-cloudtrail-logs-124737196430-56a3b94b",
                "arn:aws:s3:::aws-cloudtrail-logs-124737196430-56a3b94b/*"
            ]
        }
    ]
}