{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 10 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "expr": "sum(count_over_time({job=~\"$app\", instance=~\"$instance\"} |~ \"(?i)(error|exception|fail|fatal|critical|panic)\" [$__range]))",
          "refId": "A"
        }
      ],
      "title": "Total Errors (selected time)",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "description": "Report-style table: error count per application/job and per instance in the selected time range. Sort by Errors to see the worst offenders quickly.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "displayMode": "auto"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 10 }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Errors" },
            "properties": [
              { "id": "custom.displayMode", "value": "color-background-solid" }
            ]
          }
        ]
      },
      "gridPos": { "h": 10, "w": 18, "x": 6, "y": 0 },
      "id": 2,
      "options": {
        "cellHeight": "sm",
        "footer": { "countRows": true, "reducer": ["sum"], "show": true },
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "Errors" }]
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${datasource}" },
          "editorMode": "code",
          "expr": "sum by (job, instance) (count_over_time({job=~\"$app\", instance=~\"$instance\"} |~ \"(?i)(error|exception|fail|fatal|critical|panic)\" [$__range]))",
          "legendFormat": "{{job}} - {{instance}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Errors per Application & Instance",
      "transformations": [
        { "id": "merge", "options": {} },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true },
            "indexByName": { "job": 0, "instance": 1, "Value": 2 },
            "renameByName": {
              "job": "Application",
              "instance": "Instance",
              "Value": "Errors"
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 10 },
      "id": 3,
      "panels": [],
      "title": "📄 Per-Instance Error Report (repeats automatically)",
      "type": "row"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "description": "Actual error logs (messages) for this instance (repeat panel). Filter using the dashboard variables. Use this to read the real errors, not just counts.",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 11 },
      "id": 4,
      "maxPerRow": 1,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "pluginVersion": "10.0.0",
      "repeat": "instance",
      "repeatDirection": "v",
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${datasource}" },
          "editorMode": "code",
          "expr": "{instance=\"$instance\", job=~\"$app\"} |~ \"(?i)(error|exception|fail|fatal|critical|panic)\"",
          "refId": "A"
        }
      ],
      "title": "🔴 Errors (messages) on $instance",
      "type": "logs"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["errors", "report", "instances", "loki"],
  "templating": {
    "list": [
      {
        "current": {},
        "datasource": { "type": "loki", "uid": "${datasource}" },
        "definition": "label_values({job=~\".+\"}, instance)",
        "hide": 0,
        "includeAll": true,
        "label": "Instance",
        "multi": true,
        "name": "instance",
        "options": [],
        "query": "label_values({job=~\".+\"}, instance)",
        "refresh": 1,
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      },
      {
        "current": {},
        "datasource": { "type": "loki", "uid": "${datasource}" },
        "definition": "label_values({job=~\".+\"}, job)",
        "hide": 0,
        "includeAll": true,
        "label": "App/Project",
        "multi": true,
        "name": "app",
        "options": [],
        "query": "label_values({job=~\".+\"}, job)",
        "refresh": 1,
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      },
      {
        "current": {},
        "datasource": { "type": "loki", "uid": "${datasource}" },
        "hide": 0,
        "includeAll": false,
        "label": "Datasource",
        "multi": false,
        "name": "datasource",
        "options": [],
        "query": "loki",
        "queryValue": "",
        "refresh": 1,
        "skipUrlSync": false,
        "type": "datasource"
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "browser",
  "title": "Instance Error Report (Per-EC2 tables)",
  "uid": "instance-errors-report",
  "version": 1,
  "weekStart": ""
}
